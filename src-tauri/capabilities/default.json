{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "system-info:default",
    "system-info:allow-all",
    "log:default",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}