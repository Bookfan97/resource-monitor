{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "system-info:default",
    "system-info:allow-get-cpu-info",
    "system-info:allow-get-cpu-usage",
    "system-info:allow-get-memory-info",
    "system-info:allow-get-disk-info",
    "log:default",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}